root = Col([heading, notice, controls, summary, breakdown], 5)
$inputPrice = 2
$outputPrice = 8
$inputTokens = 1200
$outputTokens = 350
$requestsPerDay = 5000
$daysPerMonth = 30
$monthlyBudget = 1000
heading = Title("LLM cost workbench", "xl")
notice = Text("**Hypothetical prices supplied in your prompt—not real provider prices.** Edit any value to recalculate monthly costs and budget status locally.", "md", "muted")
controls = Card([Title("Assumptions", "md"), numericControls, usage], "outline", 4, 4)
numericControls = Grid([Input($inputPrice, "Hypothetical input price ($ / million tokens)", "number"), Input($outputPrice, "Hypothetical output price ($ / million tokens)", "number"), Input($inputTokens, "Average input tokens / request", "number"), Input($outputTokens, "Average output tokens / request", "number"), Input($daysPerMonth, "Days / month", "number"), Input($monthlyBudget, "Monthly budget ($)", "number")], 2, 260, 4)
usage = Slider($requestsPerDay, 0, 10000, 100, "Requests / day", "", [{value: 0, label: "0"}, {value: 5000, label: "5,000"}, {value: 10000, label: "10,000"}])
inputRate = @Clamp(@Default($inputPrice, 0), 0, 1000000)
outputRate = @Clamp(@Default($outputPrice, 0), 0, 1000000)
avgInput = @Clamp(@Default($inputTokens, 0), 0, 1000000000)
avgOutput = @Clamp(@Default($outputTokens, 0), 0, 1000000000)
days = @Clamp(@Default($daysPerMonth, 1), 1, 366)
requests = @Clamp(@Default($requestsPerDay, 0), 0, 10000)
budget = @Clamp(@Default($monthlyBudget, 0), 0, 1000000000000)
monthlyRequests = requests * days
costRows = [{type: "Input", tokens: avgInput * monthlyRequests, rate: inputRate, cost: avgInput * monthlyRequests * inputRate / 1000000}, {type: "Output", tokens: avgOutput * monthlyRequests, rate: outputRate, cost: avgOutput * monthlyRequests * outputRate / 1000000}]
monthlyCost = @Sum(costRows.cost)
remaining = budget - monthlyCost
overBudget = monthlyCost > budget
summary = Card([Row([Title("Monthly estimate", "md"), Badge(overBudget ? "Over budget" : "Within budget", overBudget ? "danger" : "success")], 3, "center", "between"), Grid([Col([Caption("Total monthly cost"), Title(@Format(monthlyCost, "currency", 2, "USD"), "2xl")], 1), Col([Caption("Remaining budget"), Title(@Format(remaining, "currency", 2, "USD"), "2xl", overBudget ? "danger" : "success")], 1), Col([Caption("Monthly requests"), Title(@Format(monthlyRequests, "number", 0), "2xl")], 1)], 3, 180, 4), Text(overBudget ? "Over your " + @Format(budget, "currency", 2, "USD") + " budget by " + @Format(-remaining, "currency", 2, "USD") + "." : "Estimated spend is within your " + @Format(budget, "currency", 2, "USD") + " monthly budget.", "sm"), Caption("Empty or negative prices, token averages, and budgets use 0. Days / month is constrained to 1–366; requests / day to 0–10,000.")], "soft", 4, 3)
breakdown = Col([Title("Input / output cost breakdown", "md"), Table(["Token type", "Monthly tokens", "Hypothetical $ / million", "Monthly cost"], @Each(costRows, "r", [r.type, @Format(r.tokens, "number", 0), @Format(r.rate, "currency", 2, "USD"), @Format(r.cost, "currency", 2, "USD")])), Caption("Monthly requests = requests / day × days / month. Each token cost = monthly requests × average tokens / request × hypothetical unit price ÷ 1,000,000. Displayed currency is rounded to cents; budget status uses unrounded costs.")], 3)